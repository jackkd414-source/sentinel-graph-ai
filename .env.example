# SentinelGraph AI - Application Configuration
# Copy to .env and fill in values. NEVER commit .env

# --- Server ---
SG_HOST=127.0.0.1
SG_PORT=8088
SG_DEBUG=false

# Shared-secret auth token, for scripts and headless use. Optional: the analyst
# account (default admin / admin123, created on first start) also authenticates.
# Binding to a non-loopback host FAILS at startup unless one of the two is
# available; once the API is reachable from the network, every /api/* request
# must send one of:
#   Authorization: Bearer <session token from POST /api/auth/login>
#   Authorization: Bearer <this token>
# CORS is NOT authentication. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SG_AUTH_TOKEN=

# How long a login session stays valid, in hours. Default 12.
SG_SESSION_TTL_HOURS=12

# The bind guard refuses a non-loopback --host while the account still carries
# the default password, because a credential printed in the README is not a
# secret. Set this to 1 only for a deliberate demo; a real deployment should
# change the password instead.
SG_ALLOW_DEFAULT_PASSWORD=false

# Comma-separated list of allowed CORS origins.
# Dev default is the Vite dev server. Do NOT use "*" in deployment.
SG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
# SQLite file path (relative to project root unless absolute)
SG_DB_PATH=data/sentinelgraph.db

# Hard cap on uploaded artifact size, bytes (default 32 MiB)
SG_MAX_UPLOAD_BYTES=33554432

# Hard cap on the WHOLE HTTP request body, bytes. Enforced at the ASGI layer
# before any multipart/JSON parser runs, so a chunked upload cannot bypass it.
# Defaults to SG_MAX_UPLOAD_BYTES + 65536 (room for multipart boundaries), which
# keeps a file of exactly SG_MAX_UPLOAD_BYTES acceptable.
# SG_MAX_REQUEST_BYTES=33619968

# Directory where imported artifacts are stored on disk
SG_ARTIFACT_DIR=data/artifacts

# --- Credential protection ---
# Master key used to encrypt provider API keys at rest (Fernet/AES-128-CBC+HMAC).
# Leave empty and SentinelGraph will refuse to persist API keys in the DB and
# will fall back to reading credentials from environment variables only.
# Generate one with:  python -m sentinelgraph.security.keys
SG_MASTER_KEY=

# --- AI provider fallback credentials (optional) ---
# These are read when no DB-stored provider config exists.
# SentinelGraph NEVER logs or returns these values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
