# ============================================================
# SentinelGraph AI — repository hygiene
# ============================================================
# Principle: anything generated at runtime, anything secret, and anything
# containing real machine telemetry must never enter version control.
# ============================================================

# --- Secrets -------------------------------------------------
# Real credentials live here. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
!docs/**/*.md

# --- Database + SQLite sidecars ------------------------------
# The working database holds real imported telemetry (hostnames, usernames,
# SIDs). It is a local artifact, never a repository file.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Runtime logs --------------------------------------------
logs/
*.log
sysmon-export.log

# --- Raw telemetry exports -----------------------------------
# These are the analyst's own machine logs. PII by definition.
/firewall.json
/security.json
/sysmon.json
/sysmon-test.json
/abstest.json

# --- Demo video / large media --------------------------------
# Recorded footage is a submission artifact, not a repository file. The current
# take is ~120 MB and GitHub rejects files over 100 MB, so it travels outside
# git: as a release asset, a shared link, or under Git LFS.
*.mp4
*.mov
*.mkv
*.webm

# --- Python --------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.eggs/

# --- Node / frontend -----------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Release bundles -----------------------------------------
# Built by tools/make_release.py; reproducible, never committed.
release/

# --- Local checkpoints / backups ------------------------------
backup/
_inspect/

# --- OS / editor noise ---------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
